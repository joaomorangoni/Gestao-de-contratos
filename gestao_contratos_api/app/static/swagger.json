{
  "openapi": "3.0.3",
  "info": {
    "title": "API de Gestão de Contratos",
    "version": "1.0.0",
    "description": "API REST para cadastro, gerenciamento e revisão de contratos."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5000"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Cadastrar usuário",
        "tags": ["Autenticação"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "João Silva"
                  },
                  "email": {
                    "type": "string",
                    "example": "joao@email.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "12345678"
                  },
                  "cpf": {
                    "type": "string",
                    "example": "12345678900"
                  },
                  "phone": {
                    "type": "string",
                    "example": "11999999999"
                  },
                  "birth_date": {
                    "type": "string",
                    "format": "date",
                    "example": "2000-01-01"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuário criado com sucesso"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "409": {
            "description": "E-mail ou CPF já cadastrado"
          }
        }
      }
    },

    "/api/auth/login": {
      "post": {
        "summary": "Realizar login",
        "tags": ["Autenticação"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "joao@email.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "12345678"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso"
          },
          "401": {
            "description": "E-mail ou senha inválidos"
          }
        }
      }
    },

    "/api/auth/me": {
      "get": {
        "summary": "Consultar usuário autenticado",
        "tags": ["Autenticação"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Usuário autenticado"
          },
          "401": {
            "description": "Token inválido ou ausente"
          },
          "404": {
            "description": "Usuário não encontrado"
          }
        }
      }
    },

    "/api/users": {
      "get": {
        "summary": "Listar usuários",
        "tags": ["Usuários"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de usuários"
          },
          "403": {
            "description": "Apenas administradores"
          }
        }
      }
    },

    "/api/users/{user_id}": {
      "get": {
        "summary": "Buscar usuário por ID",
        "tags": ["Usuários"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Usuário encontrado"
          },
          "403": {
            "description": "Sem permissão"
          },
          "404": {
            "description": "Usuário não encontrado"
          }
        }
      },
      "put": {
        "summary": "Atualizar usuário",
        "tags": ["Usuários"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "cpf": {
                    "type": "string"
                  },
                  "birth_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuário atualizado"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "403": {
            "description": "Sem permissão"
          },
          "404": {
            "description": "Usuário não encontrado"
          }
        }
      },
      "delete": {
        "summary": "Excluir usuário",
        "tags": ["Usuários"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Usuário excluído"
          },
          "403": {
            "description": "Sem permissão"
          },
          "404": {
            "description": "Usuário não encontrado"
          }
        }
      }
    },

    "/api/contracts": {
      "get": {
        "summary": "Listar contratos",
        "tags": ["Contratos"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cpf",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de contratos"
          }
        }
      },
      "post": {
        "summary": "Cadastrar contrato",
        "tags": ["Contratos"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["full_name", "cpf", "birth_date"],
                "properties": {
                  "full_name": {
                    "type": "string",
                    "example": "Carlos Silva"
                  },
                  "cpf": {
                    "type": "string",
                    "example": "98765432100"
                  },
                  "birth_date": {
                    "type": "string",
                    "format": "date",
                    "example": "1995-05-10"
                  },
                  "email": {
                    "type": "string",
                    "example": "carlos@email.com"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "address": {
                    "type": "string"
                  },
                  "job_title": {
                    "type": "string",
                    "example": "Analista"
                  },
                  "employer_name": {
                    "type": "string",
                    "example": "Empresa ABC"
                  },
                  "salary": {
                    "type": "number",
                    "example": 4500
                  },
                  "contract_start_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "contract_end_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "content_text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Contrato criado"
          },
          "400": {
            "description": "Campos obrigatórios ou datas inválidas"
          }
        }
      }
    },

    "/api/contracts/{contract_id}": {
      "get": {
        "summary": "Buscar contrato por ID",
        "tags": ["Contratos"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "contract_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Contrato encontrado"
          },
          "403": {
            "description": "Sem permissão"
          },
          "404": {
            "description": "Contrato não encontrado"
          }
        }
      },
      "put": {
        "summary": "Atualizar contrato",
        "tags": ["Contratos"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "contract_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "full_name": {
                    "type": "string"
                  },
                  "cpf": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "address": {
                    "type": "string"
                  },
                  "job_title": {
                    "type": "string"
                  },
                  "employer_name": {
                    "type": "string"
                  },
                  "salary": {
                    "type": "number"
                  },
                  "birth_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "contract_start_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "contract_end_date": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contrato atualizado"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "403": {
            "description": "Sem permissão"
          },
          "404": {
            "description": "Contrato não encontrado"
          },
          "409": {
            "description": "Contrato já revisado"
          }
        }
      },
      "delete": {
        "summary": "Excluir contrato",
        "tags": ["Contratos"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "contract_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Contrato excluído"
          },
          "403": {
            "description": "Sem permissão"
          },
          "404": {
            "description": "Contrato não encontrado"
          }
        }
      }
    },

    "/api/reviewed-contracts": {
      "get": {
        "summary": "Listar contratos revisados",
        "tags": ["Contratos Revisados"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "classification",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de contratos revisados"
          }
        }
      },
      "post": {
        "summary": "Registrar revisão",
        "tags": ["Contratos Revisados"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["source_contract_id", "score"],
                "properties": {
                  "source_contract_id": {
                    "type": "integer",
                    "example": 1
                  },
                  "score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "example": 85
                  },
                  "classification": {
                    "type": "string",
                    "example": "aprovado"
                  },
                  "ai_summary": {
                    "type": "string",
                    "example": "Contrato analisado sem riscos graves."
                  },
                  "ai_findings": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "reviewed_by": {
                    "type": "string",
                    "example": "ai"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Revisão registrada"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "403": {
            "description": "Sem permissão"
          },
          "404": {
            "description": "Contrato não encontrado"
          },
          "409": {
            "description": "Contrato já possui revisão"
          }
        }
      }
    },

    "/api/reviewed-contracts/{review_id}": {
      "get": {
        "summary": "Buscar revisão por ID",
        "tags": ["Contratos Revisados"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "review_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Revisão encontrada"
          },
          "403": {
            "description": "Sem permissão"
          },
          "404": {
            "description": "Revisão não encontrada"
          }
        }
      },
      "put": {
        "summary": "Atualizar revisão",
        "tags": ["Contratos Revisados"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "review_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "classification": {
                    "type": "string"
                  },
                  "ai_summary": {
                    "type": "string"
                  },
                  "ai_findings": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "reviewed_by": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Revisão atualizada"
          },
          "400": {
            "description": "Score inválido"
          },
          "403": {
            "description": "Sem permissão"
          },
          "404": {
            "description": "Revisão não encontrada"
          }
        }
      },
      "delete": {
        "summary": "Excluir revisão",
        "tags": ["Contratos Revisados"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "review_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Revisão excluída"
          },
          "403": {
            "description": "Sem permissão"
          },
          "404": {
            "description": "Revisão não encontrada"
          }
        }
      }
    }
  }
}