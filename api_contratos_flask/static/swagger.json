  "components": {
    "schemas": {
      "ClienteInput": {
        "type": "object",
        "required": [
          "nome",
          "tipo",
          "documento"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "example": "Empresa ABC"
          },
          "tipo": {
            "type": "string",
            "example": "PJ"
          },
          "documento": {
            "type": "string",
            "example": "12345678000190"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "contato@empresa.com"
          },
          "telefone": {
            "type": "string",
            "example": "11999999999"
          }
        }
      },
      "UsuarioInput": {
        "type": "object",
        "required": [
          "nome",
          "email",
          "senha",
          "papel"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "example": "João"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "joao@email.com"
          },
          "senha": {
            "type": "string",
            "format": "password",
            "example": "123456"
          },
          "papel": {
            "type": "string",
            "example": "ADMIN"
          }
        }
      },
      "ContratoInput": {
        "type": "object",
        "required": [
          "numero",
          "titulo",
          "cliente_id",
          "usuario_id"
        ],
        "properties": {
          "numero": {
            "type": "string",
            "example": "CTR-001"
          },
          "titulo": {
            "type": "string",
            "example": "Contrato de prestação de serviços"
          },
          "cliente_id": {
            "type": "integer",
            "example": 1
          },
          "usuario_id": {
            "type": "integer",
            "example": 1
          },
          "tipo_contrato": {
            "type": "string",
            "example": "SERVICO"
          },
          "valor_total": {
            "type": "number",
            "format": "float",
            "example": 15000.0
          },
          "data_inicio": {
            "type": "string",
            "format": "date",
            "example": "2026-09-07"
          },
          "data_fim": {
            "type": "string",
            "format": "date",
            "example": "2027-09-07"
          },
          "status": {
            "type": "string",
            "example": "ATIVO"
          }
        }
